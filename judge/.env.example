# OB 判题程序配置模板
#
# 这是旧 run_judge.py 的环境变量参考，不会自动加载。
# 当前推荐凭据位置：~/.config/minimax-ob-judge/platform.env（600，目录700），
# 启动子进程前显式source。静默输入/加载命令见 docs/运行手册.md。
# judge/.env仍被gitignore，但不要在本模板填写真实值。本仓库是PUBLIC。

# ── 平台鉴权 ───────────────────────────────────────────────────
# MiniMax 赛题 Token，由 OB 方下发。仅授权一级题 600077。
# 绝不要写进代码、命令行、日志或 commit。
OB_JUDGE_TOKEN=

# 一级赛题 ID：MiniMax = 600077（子题 800514 由领取响应返回，不要硬编码）
OB_QUESTION_ID=600077

# ── 领取策略 ───────────────────────────────────────────────────
# 以下是run_judge.py的环境变量；review.sh用--minutes（默认60），
# review.py用fetch之前的全局--timeout-minutes（默认30）。
# 必须是大于 0 的整数，且应长于正常评测耗时。
# 领取后超过这个时长未回传，任务可被再次领取 —— 两个进程同时处理同一 taskId。
# 建议设成「最慢一次评测耗时」的 1.5～2 倍。
OB_RUN_TASK_TIMEOUT_MINUTES=30

# 超时任务允许额外重领次数，不能为负
OB_RUN_TASK_RETRY=3

# ── 轮询节奏 ───────────────────────────────────────────────────
# 无任务时的等待区间（秒）。文档建议 10～30s，不要高频空转。
OB_POLL_MIN_SECONDS=10
OB_POLL_MAX_SECONDS=30
